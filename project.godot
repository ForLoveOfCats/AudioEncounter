; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AudioEncounter"
run/main_scene="res://RuntimeRoot.tscn"
config/features=PackedStringArray("4.7", "C#")
config/icon="res://icon.png"

[audio]

buses/default_bus_layout="uid://ea0dbwwee6na"

[autoload]

Game="*res://Game/Game.cs"
Sfx="*res://Game/Sfx.cs"
GlobalParticles="*res://SaneParticles/Particles.cs"

[debug]

gdscript/warnings/enable=false
settings/fps/force_fps=100

[display]

window/vsync/vsync_mode=false

[dotnet]

project/assembly_name="AudioEncounter"

[editor_plugins]

enabled=PackedStringArray("qodot")

[filesystem]

import/blender/enabled=false

